{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "VK_LAYER_FRAMEPACER_limiter",
    "type": "GLOBAL",
    "library_path": "@LIBPATH@",
    "api_version": "1.4.0",
    "implementation_version": "1",
    "description": "FramePacer - limitador de FPS controlavel em tempo real",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": { "ENABLE_FRAMEPACER": "1" },
    "disable_environment": { "DISABLE_FRAMEPACER": "1" }
  }
}
